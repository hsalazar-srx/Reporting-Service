{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/reporting-service-.log",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithCorrelationId",
      "WithMachineName"
    ]
  },

  "ApiKeys": {
    "Primary": "",
    "Admin": ""
  },

  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },

  "Report": {
    "ExecutionTimeoutSeconds": 300
  },

  "Catalog": {
    "Path": "config/report-catalog.json",
    "ReloadIntervalSeconds": 3600
  },

  "DataSources": {
    "Db2": {
      "ConnectionString": "{{FROM_USER_SECRETS}}",
      "Schema": "mvxcdta",
      "CommandTimeoutSeconds": 120,
      "MovexUser": "SRXAPI"
    },
    "Sqlite": {
      "ConnectionString": "{{FROM_USER_SECRETS}}",
      "CommandTimeoutSeconds": 60
    }
  },

  "ExchangeRateSync": {
    "Enabled": true,
    "ScheduleTimeUtc": "23:00",
    "CheckIntervalMinutes": 60,
    "RbaUrl": "https://www.rba.gov.au/statistics/tables/csv/f11.1-data.csv",
    "TimeoutSeconds": 30,
    "SkipWeekends": true,
    "FallbackDays": 3,
    "DbCommandTimeoutSeconds": 30,
    "Currencies": [ "USD", "HKD", "EUR", "JPY", "GBP", "NZD" ]
  },

  "Swagger": {
    "EnableUI": false
  }
}
