{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/reporting-service-.log",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithCorrelationId",
      "WithMachineName"
    ]
  },

  "ApiKeys": {
    "Primary": "",
    "Admin": ""
  },

  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },

  "Report": {
    "ExecutionTimeoutSeconds": 300
  },

  "Catalog": {
    "Path": "config/report-catalog.json",
    "ReloadIntervalSeconds": 300
  },

  "DataSources": {
    "Db2": {
      "ConnectionString": "",
      "Schema": "mvxcdta",
      "CommandTimeoutSeconds": 120
    },
    "SqlServer": {
      "ConnectionString": "",
      "CommandTimeoutSeconds": 60
    }
  },

  "Swagger": {
    "EnableUI": false
  }
}
