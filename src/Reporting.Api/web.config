<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Reporting.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ASPNETCORE_CONTENTROOT" value="%APPL_PHYSICAL_PATH%" />
          <!-- Path to the protected secrets file (NOT the secrets themselves).   -->
          <!-- File lives outside the deployment folder — survives redeployments. -->
          <!-- NTFS ACLs grant Read to "IIS AppPool\ReportingService" only.       -->
          <!-- Run scripts\Setup-ServerSecrets.ps1 on SRXWEBAPP1 to create it.    -->
          <environmentVariable name="REPORTING_SECRETS_PATH"
                               value="C:\ProgramData\Scanfil\Reporting\secrets.json" />
        </environmentVariables>
      </aspNetCore>
      
    </system.webServer>
  </location>
</configuration>
